{
  "name": "bagful",
  "private": true,
  "version": "0.7.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build && node scripts/strip-sourcemaps.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "types": "supabase gen types typescript --local --schema public > src/types/database.ts && supabase --workdir catalog gen types typescript --local --schema public > src/types/catalog.ts",
    "catalog:scrape": "npm --prefix catalog run scrape --",
    "catalog:scrape:auchan": "npm --prefix catalog run scrape:auchan",
    "catalog:scrape:carrefour": "npm --prefix catalog run scrape:carrefour",
    "catalog:scrape:lidl": "npm --prefix catalog run scrape:lidl",
    "catalog:scrape:all": "npm --prefix catalog run scrape:all",
    "catalog:import": "npm --prefix catalog run import --",
    "catalog:unit": "npm --prefix catalog test",
    "catalog:test": "supabase --workdir catalog db reset && supabase --workdir catalog test db",
    "lint": "eslint .",
    "bots": "node bots/swarm.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@clerk/localizations": "^4.15.4",
    "@clerk/vue": "^2.4.28",
    "@onesignal/capacitor-plugin": "^1.1.4",
    "@sentry/vue": "^10.63.0",
    "@supabase/supabase-js": "^2.112.3",
    "barcode-detector": "^3.2.1",
    "posthog-js": "^1.434.17",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0",
    "zxing-wasm": "3.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
