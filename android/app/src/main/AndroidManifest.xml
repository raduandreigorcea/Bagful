<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Scanning a barcode onto the list. There is no camera plugin: the web
         layer calls getUserMedia, and Capacitor's WebView grants it only if the
         permission is declared here and the user allows it at the prompt.
         required="false" so a device without a camera can still install the app;
         the add form asks what the device can do before offering the button. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Auto Backup off. This was Capacitor's scaffolded `true` and had never
         been revisited, which meant Android was copying the app's data
         directory to the user's Google Drive: the WebView's localStorage —
         the list snapshot, the remembered user id, and any offline writes
         still waiting to be sent — along with whatever Clerk persists beside
         it. For a shopping list that is mild; for the session state sitting in
         the same store it is auth material leaving the device, off to a place
         this app has no say over and cannot clear on sign-out.

         `false` rather than a dataExtractionRules/fullBackupContent allowlist
         because minSdk 24 to targetSdk 36 spans both mechanisms, and there is
         nothing here worth backing up anyway: every byte of it is a cache or a
         hint that the server can rebuild on the next sign-in. If backup is ever
         wanted for something that genuinely cannot be rebuilt, turn it on with
         a ruleset that excludes the WebView data directory rather than
         reverting this line. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth return leg: Clerk redirects the system browser to
                 <scheme>://sso-callback, which re-opens this activity
                 (singleTask, so the running instance receives it as an
                 appUrlOpen event instead of a relaunch).

                 The scheme is per flavour (bagful, bagfulnightly) because a
                 URL scheme is claimed per app and both are installable at once;
                 see the productFlavors block in build.gradle for why, and
                 src/lib/ssoScheme.ts for the half that sends the link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${ssoScheme}" android:host="sso-callback" />
            </intent-filter>

        </activity>

        <!-- Tints OneSignal notifications (icon + app name row) Bagful green;
             the small icon itself is ic_stat_onesignal_default in drawable-*. -->
        <meta-data
            android:name="com.onesignal.NotificationAccentColor.DEFAULT"
            android:value="FF4D8C65" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Updating the app from inside the app. Bagful is downloaded as an APK
         rather than installed from a store, so nothing updates it on the user's
         behalf; AppInstallerPlugin fetches the new release and hands it to the
         system installer, which is refused outright without this. Declaring it
         is not consent: since Android 8 the user still has to allow "install
         unknown apps" for Bagful specifically, and the plugin checks for that
         before it downloads anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
